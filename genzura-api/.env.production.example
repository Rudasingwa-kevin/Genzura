# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env.production and fill in real production values

PORT=5000
NODE_ENV=production

# Database - Production PostgreSQL
DATABASE_URL="postgresql://prod_user:STRONG_PASSWORD@prod-db-host:5432/genzura_prod?schema=public&sslmode=require"

# Security - CRITICAL: Generate a strong random string (min 32 characters)
# Use: openssl rand -base64 48
JWT_SECRET="GENERATE_STRONG_RANDOM_SECRET_MINIMUM_32_CHARACTERS_USE_OPENSSL"

# URLs - Production domains
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Brevo Email Service - Production SMTP credentials
# Get from: https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_USER="production-smtp-user@smtp-brevo.com"
BREVO_SMTP_KEY="xsmtpsib-production-smtp-key-here"

# Verified Sender - Must be verified in Brevo dashboard
SENDER_EMAIL="noreply@yourdomain.com"
SENDER_NAME="Genzura Legal"

# AWS S3 Storage - Production bucket and credentials
# Create separate production bucket and IAM user with minimal permissions
AWS_ACCESS_KEY_ID="production-access-key-id"
AWS_SECRET_ACCESS_KEY="production-secret-access-key"
AWS_REGION="eu-north-1"
AWS_S3_BUCKET="genzura-production-files"

# IMPORTANT SECURITY NOTES:
# 1. Never commit this file with real credentials to Git
# 2. Use AWS Secrets Manager or similar for credential management
# 3. Rotate all API keys and secrets before production deployment
# 4. Use different S3 buckets for dev/staging/production
# 5. Ensure database uses SSL (sslmode=require in DATABASE_URL)
# 6. Set up proper IAM roles with least privilege access
# 7. Enable CloudWatch logging for monitoring
# 8. Configure CORS properly for production domains

PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/genzura_db?schema=public"
JWT_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_AT_LEAST_32_CHARS"
NODE_ENV=development

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# API URL (for internal references)
API_URL=http://localhost:5000

# Brevo Email Service (SMTP)
# Get these from: https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_USER="your-smtp-user@smtp-brevo.com"
BREVO_SMTP_KEY="xsmtpsib-your-actual-smtp-key-here"

# Verified Sender (must be verified in Brevo dashboard)
SENDER_EMAIL="your-verified-email@example.com"
SENDER_NAME="Genzura Legal"

# AWS S3 Storage (Optional: falls back to local disk storage if not configured)
# Get these from AWS IAM console
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="eu-north-1"
AWS_S3_BUCKET="your-s3-bucket-name"

# Sentry Error Monitoring (Optional - for production error tracking)
# Get from: https://sentry.io (free tier available)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

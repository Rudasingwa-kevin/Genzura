# Database
DATABASE_URL="postgresql://user:password@localhost:5432/genzura_db"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:5173"

# Brevo (Sendinblue) Email Service
# Get these from: https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_USER="your-email@example.com"
BREVO_SMTP_KEY="your-brevo-smtp-key-here"

# Alternative: Use API key instead of SMTP
# BREVO_API_KEY="xkeysib-xxxxx..."

# AWS S3 Storage (Optional: falls back to local disk storage if not configured)
# Get these from AWS IAM Console: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket-name"


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  Senior_Attorney
  Attorney
  Paralegal
  Support
}

enum UserStatus {
  Active
  Invited
  Suspended
}


enum CaseStatus {
  Active
  Pending
  Resolved
  Archived
}

enum CasePriority {
  High
  Medium
  Low
}

enum CaseType {
  Litigation
  Corporate
  Compliance
  IP
  Employment
  MA
  Real_Estate
}

enum TimelineEventType {
  filed
  status
  meeting
  document
  note
  milestone
  updated
  team_added
  team_removed
}

enum DocumentType {
  PDF
  DOCX
  XLSX
  IMG
}

enum FeedbackStatus {
  Pending
  Reviewed
  In_Progress
  Resolved
}

enum NotificationType {
  case
  deadline
  document
  alert
  resolved
  invitation
}

model User {
  id                    String           @id @default(cuid())
  name                  String
  email                 String           @unique
  passwordHash          String
  role                  UserRole         @default(Attorney)
  status                UserStatus       @default(Active)
  lastActive            DateTime         @default(now())
  initials              String
  avatarUrl             String?
  // Profile fields
  phone                 String?
  company               String?
  location              String?
  jobTitle              String?
  language              String?          @default("EN")
  bio                   String?          @db.Text  // Attorney bio/description
  education             String?          // Education background
  barNumber             String?          // Bar association number
  yearsOfExperience     Int?             // Explicit years of experience
  specializations       String[]         // Practice areas

  // Invitation fields
  invitationToken       String?          @unique
  invitationExpiry      DateTime?
  // Relations
  cases                 Case[]           @relation("AttorneyCases")
  teamMemberships       CaseTeam[]
  timelineEvents        TimelineEvent[]
  uploadedDocs          CaseDocument[]
  notes                 CaseNote[]
  feedback              Feedback[]
  notifications         Notification[]
  calendarEvents        CalendarEvent[]
  eventAttendees        EventAttendee[]
  notificationPreferences NotificationPreference?
  professionalDocuments AttorneyDocument[]  // CV, certificates, etc.
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Client {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  company      String?
  industry     String?
  address      String?
  idNumber     String?    // National ID or TIN
  cases        Case[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Case {
  id            String          @id @default(cuid())
  caseNumber    String          @unique
  title         String
  client        Client          @relation(fields: [clientId], references: [id])
  clientId      String
  attorney      User            @relation("AttorneyCases", fields: [attorneyId], references: [id])
  attorneyId    String
  status        CaseStatus      @default(Pending)
  priority      CasePriority    @default(Medium)
  type          CaseType
  deadline      DateTime?
  extendDate    DateTime?
  filedDate     DateTime        @default(now())
  description   String          @db.Text
  team          CaseTeam[]
  timeline      TimelineEvent[]
  documents     CaseDocument[]
  notes         CaseNote[]
  events        CalendarEvent[]
  applicableLaws CaseLaw[]      // Rwandan laws applicable to this case
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clientId])
  @@index([attorneyId])
}

model CaseTeam {
  id      String @id @default(cuid())
  case    Case   @relation(fields: [caseId], references: [id])
  caseId  String
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  role    String // Specific role in this case

  @@unique([caseId, userId])
  @@index([userId])
}

model TimelineEvent {
  id          String            @id @default(cuid())
  case        Case              @relation(fields: [caseId], references: [id])
  caseId      String
  type        TimelineEventType
  description String
  author      User              @relation(fields: [authorId], references: [id])
  authorId    String
  timestamp   DateTime          @default(now())

  @@index([caseId])
  @@index([authorId])
}

model CaseDocument {
  id           String       @id @default(cuid())
  case         Case         @relation(fields: [caseId], references: [id])
  caseId       String
  name         String
  type         DocumentType
  size         String
  fileUrl      String?
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  uploadedById String
  uploadedAt   DateTime     @default(now())

  @@index([caseId])
  @@index([uploadedById])
}

model CaseNote {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  text      String   @db.Text
  timestamp DateTime @default(now())

  @@index([caseId])
  @@index([authorId])
}

model Feedback {
  id        String         @id @default(cuid())
  user      User?          @relation(fields: [userId], references: [id])
  userId    String?
  subject   String
  category  String
  message   String         @db.Text
  status    FeedbackStatus @default(Pending)
  createdAt DateTime       @default(now())

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  metadata  Json?            // Additional data (e.g., invitationId, caseId)
  createdAt DateTime         @default(now())

  @@index([userId])
}

enum InvitationStatus {
  Pending
  Approved
  Rejected
}

model CaseInvitation {
  id           String           @id @default(cuid())
  caseId       String
  inviteeId    String           // User being invited
  inviterId    String           // User who sent the invitation
  role         String           // Role in the case (e.g., "Team Member")
  status       InvitationStatus @default(Pending)
  message      String?          @db.Text
  createdAt    DateTime         @default(now())
  respondedAt  DateTime?

  @@index([caseId])
  @@index([inviteeId])
  @@index([inviterId])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  category  String
  updatedAt DateTime @updatedAt
}

enum CalendarEventType {
  CourtDate
  Hearing
  Filing
  Deadline
  Meeting
  ClientMeeting
  Consultation
  Other
}

model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  eventType   CalendarEventType
  startDate   DateTime
  endDate     DateTime?
  location    String?
  caseId      String?
  case        Case?             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attendees   EventAttendee[]
  reminders   EventReminder[]
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([caseId])
  @@index([createdById])
}

model EventAttendee {
  id      String        @id @default(cuid())
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User          @relation(fields: [userId], references: [id])
  userId  String

  @@unique([eventId, userId])
  @@index([userId])
}

enum ReminderMethod {
  Email
  SMS
  InApp
}

model EventReminder {
  id             String          @id @default(cuid())
  event          CalendarEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  reminderTime   DateTime
  method         ReminderMethod
  sent           Boolean         @default(false)
  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  @@index([eventId])
}


model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Email notification preferences
  caseAssignments       Boolean  @default(true)
  timelineMilestones    Boolean  @default(true)
  documentActivity      Boolean  @default(false)
  securityAlerts        Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_INVITED
  USER_LOGIN
  USER_LOGOUT
  USER_PASSWORD_RESET
  CASE_CREATED
  CASE_UPDATED
  CASE_DELETED
  CASE_STATUS_CHANGED
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  DOCUMENT_DELETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  SETTINGS_UPDATED
  PLAN_UPDATED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_PAUSED
  SUBSCRIPTION_CHANGED
  SYSTEM_BACKUP
  SECURITY_ALERT
  UNAUTHORIZED_ACCESS
  EXPORT_DATA
  BULK_OPERATION
}

enum AuditStatus {
  SUCCESS
  FAILED
  PENDING
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  description String

  // User who performed the action
  userId      String?
  userName    String?
  userRole    String?

  // Request details
  ipAddress   String?
  userAgent   String?
  method      String?     // HTTP method (GET, POST, etc.)
  endpoint    String?     // API endpoint

  // Result
  status      AuditStatus @default(SUCCESS)
  errorMessage String?    @db.Text

  // Additional context
  resourceType String?    // e.g., "User", "Case", "Document"
  resourceId   String?    // ID of affected resource
  metadata     Json?      // Additional flexible data

  // Timestamps
  timestamp   DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([status])
  @@index([timestamp])
  @@index([resourceType, resourceId])
}

// ═══════════════════════════════════════════════════════════════════════════
// RWANDAN LEGAL DATABASE
// ═══════════════════════════════════════════════════════════════════════════

enum LegalCodeType {
  Civil_Code           // Code Civil
  Penal_Code           // Code Pénal
  Commercial_Code      // Commercial Law
  Labor_Code           // Labor Law
  Land_Code            // Land Law
  Tax_Code             // Tax Law
  Family_Code          // Family Law
  Environmental_Code   // Environmental Law
  Administrative_Code  // Administrative Law
  Intellectual_Property // IP Law
  Corporate_Law        // Company Law
  Banking_Law          // Banking & Finance
  Insurance_Law        // Insurance
  Constitution         // Constitution of Rwanda
  Other
}

enum LegalStatus {
  Active      // Currently in force
  Amended     // Has been amended (link to newer version)
  Repealed    // No longer in force
  Proposed    // Proposed legislation
}

// Main legal code/law document
model LegalCode {
  id              String          @id @default(cuid())

  // Identification
  code            String          @unique // e.g., "LAW_N_27_2021"
  officialTitle   String          // Official title in Kinyarwanda
  titleEN         String?         // English translation
  titleFR         String?         // French translation
  shortName       String          // e.g., "Penal Code 2018"

  // Classification
  type            LegalCodeType
  status          LegalStatus     @default(Active)
  category        String[]        // Tags: ["Criminal", "Property", "Theft"]

  // Legal Details
  enactmentDate   DateTime        // When law was passed
  effectiveDate   DateTime        // When it became effective
  officialGazette String?         // Official Gazette reference
  lawNumber       String?         // e.g., "N° 27/2021"

  // Content
  summary         String?         @db.Text // Brief overview
  fullText        String?         @db.Text // Complete legal text (optional)
  pdfUrl          String?         // Link to official PDF

  // Relationships
  articles        LegalArticle[]
  relatedCodes    LegalCodeRelation[] @relation("RelatedFrom")
  relatingCodes   LegalCodeRelation[] @relation("RelatedTo")
  amendments      LegalAmendment[]
  caseLaws        CaseLaw[]

  // Search optimization
  searchVector    String?         @db.Text // For full-text search

  // Metadata
  createdBy       String?
  lastReviewedAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type])
  @@index([status])
  @@index([code])
  @@index([enactmentDate])
}

// Individual articles within a legal code
model LegalArticle {
  id              String       @id @default(cuid())

  // Identification
  legalCode       LegalCode    @relation(fields: [legalCodeId], references: [id], onDelete: Cascade)
  legalCodeId     String
  articleNumber   String       // e.g., "123", "45bis", "Art. 567"

  // Structure
  title           String?      // Article title/heading
  section         String?      // Section it belongs to
  chapter         String?      // Chapter it belongs to
  book            String?      // Book (for larger codes)

  // Content
  textKY          String       @db.Text // Kinyarwanda
  textEN          String?      @db.Text // English
  textFR          String?      @db.Text // French

  // Context
  summary         String?      @db.Text // Plain language summary
  keywords        String[]     // Keywords for matching
  applicableTo    CaseType[]   // Which case types this applies to

  // Penalties/Consequences (if applicable)
  penaltyMin      String?      // e.g., "6 months"
  penaltyMax      String?      // e.g., "5 years"
  fineMin         Int?         // Fine in RWF
  fineMax         Int?         // Fine in RWF

  // Relationships
  relatedArticles LegalArticleRelation[] @relation("ArticleFrom")
  relatingArticles LegalArticleRelation[] @relation("ArticleTo")
  caseLaws        CaseLaw[]

  // Metadata
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([legalCodeId, articleNumber])
  @@index([legalCodeId])
  @@index([section])
  @@index([applicableTo])
}

// Relationships between legal codes (e.g., amendments, references)
model LegalCodeRelation {
  id            String    @id @default(cuid())
  fromCode      LegalCode @relation("RelatedFrom", fields: [fromCodeId], references: [id], onDelete: Cascade)
  fromCodeId    String
  toCode        LegalCode @relation("RelatedTo", fields: [toCodeId], references: [id], onDelete: Cascade)
  toCodeId      String
  relationType  String    // "amends", "repeals", "references", "implements"
  description   String?   @db.Text
  createdAt     DateTime  @default(now())

  @@unique([fromCodeId, toCodeId, relationType])
}

// Relationships between articles
model LegalArticleRelation {
  id              String       @id @default(cuid())
  fromArticle     LegalArticle @relation("ArticleFrom", fields: [fromArticleId], references: [id], onDelete: Cascade)
  fromArticleId   String
  toArticle       LegalArticle @relation("ArticleTo", fields: [toArticleId], references: [id], onDelete: Cascade)
  toArticleId     String
  relationType    String       // "references", "modifies", "contradicts", "clarifies"
  description     String?
  createdAt       DateTime     @default(now())

  @@unique([fromArticleId, toArticleId, relationType])
}

// Track amendments to laws
model LegalAmendment {
  id              String    @id @default(cuid())
  legalCode       LegalCode @relation(fields: [legalCodeId], references: [id], onDelete: Cascade)
  legalCodeId     String
  amendmentDate   DateTime
  amendmentBy     String    // Law that made the amendment
  description     String    @db.Text
  affectedArticles String[] // Article numbers affected
  createdAt       DateTime  @default(now())

  @@index([legalCodeId])
}

// Link cases to applicable laws
model CaseLaw {
  id              String       @id @default(cuid())

  // Case reference
  case            Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId          String

  // Legal reference (can link to either Code or specific Article)
  legalCode       LegalCode?   @relation(fields: [legalCodeId], references: [id])
  legalCodeId     String?
  legalArticle    LegalArticle? @relation(fields: [legalArticleId], references: [id])
  legalArticleId  String?

  // Application details
  relevance       String       @default("Primary") // "Primary", "Secondary", "Referenced"
  notes           String?      @db.Text // How this law applies to the case
  suggestedBy     String?      // "AI" or userId
  confirmedBy     String?      // userId who confirmed relevance

  // Metadata
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([caseId, legalCodeId, legalArticleId])
  @@index([caseId])
  @@index([legalCodeId])
  @@index([legalArticleId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ATTORNEY PROFESSIONAL DOCUMENTS
// ═══════════════════════════════════════════════════════════════════════════

enum AttorneyDocumentType {
  CV                    // Curriculum Vitae / Resume
  Certificate           // Professional certificates
  BarLicense            // Bar association license
  Education             // Degrees, diplomas
  Award                 // Awards and recognitions
  Publication           // Published articles, papers
  Other                 // Other professional documents
}

model AttorneyDocument {
  id              String                @id @default(cuid())

  // Owner
  attorney        User                  @relation(fields: [attorneyId], references: [id], onDelete: Cascade)
  attorneyId      String

  // Document details
  type            AttorneyDocumentType
  title           String                // e.g., "Bar License 2020", "MBA Degree"
  description     String?               @db.Text
  fileUrl         String                // S3 URL or local path
  fileName        String                // Original file name
  fileSize        Int?                  // Size in bytes
  mimeType        String?               // e.g., "application/pdf"

  // Visibility
  isPublic        Boolean               @default(true)  // Show on public profile
  displayOrder    Int                   @default(0)     // Order in profile

  // Metadata
  issuedDate      DateTime?             // When certificate/degree was issued
  expiryDate      DateTime?             // If applicable (e.g., licenses)
  issuer          String?               // Issuing organization

  // Audit
  uploadedAt      DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([attorneyId])
  @@index([type])
  @@index([isPublic])
}
